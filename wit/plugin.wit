// The Tether plugin host API, version 1.
//
// A plugin's `plugin.toml` says `host_api = "1"`: it is built against
// `tether:plugin@1.x`. Unstable until milestone 3 ends, then frozen: after
// that, the types and functions here never change within 1.x. New things
// (page elements included) arrive as new types, functions, interfaces or
// exports, so a plugin built against an earlier 1.x keeps loading. Wasmtime
// matches imports by semver, but checks records, variants and enums
// structurally: adding a case or a field to an existing one would break
// every installed plugin, so that is never done within 1.x.
package tether:plugin@1.0.0;

/// Structured logs into the plugin's log in the admin panel.
interface log {
    enum level {
        debug,
        info,
        warn,
        error,
    }

    write: func(level: level, message: string);
}

/// Pages described as data. The host validates them and renders them with
/// its own templates and design tokens; plugins never send HTML, CSS or
/// JavaScript.
interface page {
    /// How strongly a badge is coloured.
    enum tone {
        neutral,
        success,
        warning,
        danger,
        /// The screen's one highlight: use sparingly.
        accent,
    }

    record badge {
        label: string,
        tone: tone,
    }

    /// A link to another page of the same plugin.
    record link {
        label: string,
        /// Relative to the plugin's pages, e.g. `moons/40161234`. As a
        /// value (a table's or a card's), it may carry a query
        /// (`moons?moon=40161234`, names and values as a redirect's): to the
        /// page being shown, its parameters join the page's own address,
        /// keeping its search and filters (a row selecting its record
        /// panel).
        path: string,
        /// Drawn as a primary button (e.g. "Create timer" beside a page's
        /// title) rather than as a link. At most one per screen region.
        primary: bool,
    }

    /// A button that posts, like a one-button form: for row actions such
    /// as Approve, Reject or Close. Posting it calls the plugin's `submit`
    /// with `form` and `fields` as the submission, once the host has
    /// checked that the page, as `render` draws it for that person and
    /// address then, has this very button (the same form and fields), so
    /// nobody can post values the page didn't offer them. A button only a
    /// `submit` result shows can't post.
    record action {
        label: string,
        /// Lowercase letters, digits and `_`, starting with a letter; not
        /// the id of a form on the same page.
        form: string,
        /// Hidden values it posts (at most 10), e.g. the row's id: names as
        /// for form fields, unique; values without control characters.
        fields: list<tuple<string, string>>,
        /// `danger` for destructive actions; `accent` for the one primary
        /// action of a region; anything else is an outline button.
        tone: tone,
        /// With a confirmation first: one sentence stating what will
        /// happen ("Its 4 members lose access"), not "Are you sure?".
        confirm: option<string>,
    }

    /// What an entity is: which picture CCP's image server has for it.
    enum entity-kind {
        /// A portrait.
        character,
        /// A logo.
        corporation,
        alliance,
        faction,
        /// An item or ship type: its icon.
        %type,
    }

    /// A character, corporation, alliance, faction or type, drawn as its
    /// 20px picture and its name. The host builds the picture's address
    /// from the kind and id (a plugin never gives a URL); an id of 0 or less
    /// gets initials.
    record entity {
        kind: entity-kind,
        id: s64,
        name: string,
        /// One of the plugin's pages about it: its name links there (a
        /// row's name opening its record), as a `link` value's path, query
        /// and all.
        link: option<string>,
    }

    /// A thin bar, filled from 0 to 1.
    record progress {
        /// 0 to 1: how full it is. Used unless `from` and `to` are given.
        fraction: f64,
        /// With `to`: the RFC 3339 instants it runs between, for something
        /// with a known end (a skill in training). The bar then fills live
        /// in the browser. Give both or neither; `to` after `from`.
        %from: option<string>,
        to: option<string>,
        /// A few words above the bar.
        label: option<string>,
    }

    /// A skill's level as EVE's five squares.
    record levels {
        /// 0 to 5: levels trained, drawn filled.
        trained: u8,
        /// The level in training (above `trained`, at most 5), outlined in
        /// the signal colour.
        training: option<u8>,
    }

    /// One part of a whole, such as an ore in a moon.
    record share {
        label: string,
        /// Above 0: the host draws each part's amount against the sum.
        amount: f64,
        /// 0 to 4: how valuable, drawn darker to brighter (a moon's ores:
        /// R4, R8, R16, R32, R64).
        grade: u8,
    }

    /// What something is made of, drawn as a ring of its parts: small in a
    /// table, large with `center` in its middle (e.g. a moon's value).
    record composition {
        /// 1 to 8.
        parts: list<share>,
        /// A few words in the middle; given, the ring is drawn large.
        center: option<string>,
    }

    /// A structure's defenses as EVE's three rings: shield outside, then
    /// armor, then hull. Each 0 to 1.
    record defenses {
        shield: f64,
        armor: f64,
        hull: f64,
        /// Under attack or reinforced: the core pulses.
        alarm: bool,
    }

    /// A value, typed so the host formats it the same way everywhere.
    variant value {
        text(string),
        /// A count or an ID: monospaced, right-aligned.
        number(s64),
        /// ISK, abbreviated in tables (`1.24b`).
        isk(f64),
        /// An instant in EVE time (UTC), RFC 3339.
        time(string),
        badge(badge),
        link(link),
        entity(entity),
        /// An instant (RFC 3339) shown as the time left until it, ticking
        /// live ("2d 4h 13m"), with the EVE time on hover; "done" once it
        /// has passed.
        countdown(string),
        progress(progress),
        /// A button that posts (see `action`).
        action(action),
        /// Several, side by side (at most 4): a row's actions.
        actions(list<action>),
        /// One of the plugin's own pages as its full address, to share
        /// outside Tether (a FAT link's register page, in fleet chat): a
        /// link path, as for `link`. The host writes the site's address
        /// before it and draws it read-only with a Copy button.
        share(string),
        /// Tether's own Add data source button (AA's Add Owner), with these
        /// words (e.g. "Log in with the fleet boss"; "Add data source" when
        /// empty), for apps with data-source scopes: one EVE login with one
        /// of the viewer's own characters adds it as the app's data source,
        /// and brings them back to this page with that character's id as
        /// `owner` in the query. Anyone can type a query: treat `owner` as
        /// a hint, and use it only if it's one of the viewer's characters
        /// and one of `esi.data-sources`. Drawn only for those who may add
        /// data sources (holders of an `add_...` permission of the app, and
        /// app admins), with the host's own words and the scopes beside it;
        /// nothing for anyone else.
        add-owner(string),
        /// A skill's level (see `levels`).
        levels(levels),
        /// What something is made of, as a ring (see `composition`).
        composition(composition),
        /// Shield, armor and hull (see `defenses`).
        defenses(defenses),
    }

    record stat {
        label: string,
        value: value,
        caption: option<string>,
    }

    record column {
        label: string,
        /// Right-aligned: for numbers, ISK and times.
        numeric: bool,
    }

    record table {
        title: option<string>,
        columns: list<column>,
        rows: list<list<value>>,
        /// Shown when there are no rows.
        empty: option<string>,
    }

    record card {
        title: string,
        description: option<string>,
        /// Label and value pairs.
        fields: list<tuple<string, value>>,
    }

    /// A choice in a select field.
    record choice {
        value: string,
        label: string,
    }

    record text-input {
        value: option<string>,
        /// At most 10,000; 200,000 for a textarea (a pasted inventory).
        max-length: u32,
        placeholder: option<string>,
    }

    record number-input {
        value: option<f64>,
        min: option<f64>,
        max: option<f64>,
        /// Whole numbers only.
        integer: bool,
    }

    record select-input {
        /// At most 100.
        options: list<choice>,
        /// The chosen option's value.
        value: option<string>,
    }

    variant field-kind {
        text(text-input),
        textarea(text-input),
        number(number-input),
        select(select-input),
        /// Whether it starts ticked.
        checkbox(bool),
    }

    record field {
        /// Lowercase letters, digits and `_`, unique within the form.
        name: string,
        label: string,
        help: option<string>,
        required: bool,
        kind: field-kind,
    }

    /// A form. Posting it calls the plugin's `submit` with the values, once
    /// the host has checked them against these fields.
    record form {
        /// Lowercase letters, digits and `_`, unique on the page.
        id: string,
        title: option<string>,
        description: option<string>,
        /// 1 to 30.
        fields: list<field>,
        submit-label: string,
    }

    /// One group of a settings form: a heading, a line about it, and its
    /// fields.
    record settings-group {
        title: string,
        description: option<string>,
        /// 1 to 30.
        fields: list<field>,
    }

    /// A settings page's form (DESIGN.md, Save bar): its fields in groups,
    /// saved at once from a bar that appears once something changed (each
    /// changed field marked, Discard putting them back), and leaving with
    /// changes unsaved asks first. Posting it calls `submit` with its id
    /// and every field's value, checked as a form's.
    record settings-form {
        /// As a form's: lowercase letters, digits and `_`, unique on the
        /// page.
        id: string,
        /// 1 to 16; at most 120 fields in all, names unique across them.
        groups: list<settings-group>,
    }

    /// The top of a page about one character or corporation: its portrait
    /// or logo, name, corporation and alliance, and a grid of facts.
    record profile {
        /// Usually a character; a corporation shows its logo.
        subject: entity,
        /// A line under the name (e.g. "Main of 3 characters").
        subtitle: option<string>,
        corporation: option<entity>,
        alliance: option<entity>,
        /// Label and value pairs, three or four to a row.
        facts: list<tuple<string, value>>,
        /// Shown after the name.
        badges: list<badge>,
    }

    /// One card of a grid: a profile drawn compactly (portrait, name,
    /// corporation and alliance, facts stacked), opening one of the
    /// plugin's pages.
    record profile-card {
        profile: profile,
        /// The page the card opens, e.g. `character/90000001`: a link path
        /// relative to the plugin's pages, as for `link`.
        link: option<string>,
    }

    /// A grid of compact profile cards, e.g. My Characters: one card per
    /// character (at most 100).
    record card-grid {
        items: list<profile-card>,
        /// Start the grid with Tether's own "Register Character" card,
        /// which opens registering characters for this plugin. Only for plugins with user
        /// scopes (`capabilities.esi.user`): elsewhere it is left out.
        register: bool,
    }

    /// Text to copy, such as a fitting in EFT format: shown as it is, in a
    /// monospaced block, with a button that copies it.
    record code-block {
        title: option<string>,
        /// Kept exactly, line breaks and spaces included.
        text: string,
        /// The button's words; "Copy" when left out.
        copy-label: option<string>,
    }

    /// One event in a timeline's lane.
    record lane-item {
        label: string,
        /// When it happens, RFC 3339.
        at: string,
        /// With an end (RFC 3339, after `at`): drawn as a bar.
        until: option<string>,
        /// `warning` for what needs attention soon, `danger` for hostile,
        /// `success` for friendly, else neutral.
        tone: tone,
        /// A proposal rather than something that will happen (a planner's
        /// suggestion): drawn dashed.
        planned: bool,
        /// One of the plugin's pages about it, as for `link`.
        link: option<string>,
    }

    /// A row of a timeline.
    record lane {
        label: string,
        /// A few words under the label.
        caption: option<string>,
        /// At most 50.
        items: list<lane-item>,
    }

    /// A shaded stretch across every lane (e.g. prime time).
    record window {
        %from: string,
        to: string,
    }

    /// Events laid out on lanes across a span of time, with day ticks and a
    /// "now" line: fleets, timers, moon chunks, a planner's proposals.
    record timeline {
        title: option<string>,
        /// The span shown, RFC 3339; at most 60 days.
        %from: string,
        to: string,
        /// 1 to 20.
        lanes: list<lane>,
        /// At most 60.
        windows: list<window>,
    }

    variant section {
        stats(list<stat>),
        table(table),
        card(card),
        /// A paragraph of plain text.
        text(string),
        form(form),
        profile(profile),
        code(code-block),
        /// A grid of profile cards (My Characters).
        cards(card-grid),
        /// Events on lanes across time (see `timeline`).
        timeline(timeline),
        /// A settings page's form, saved at once (see `settings-form`).
        settings(settings-form),
    }

    record tab {
        label: string,
        sections: list<section>,
    }

    /// A filter in a page's toolbar: a query parameter and the values it
    /// may take. Applied, it is a chip with a × that takes it off again;
    /// `render` reads it from the request's query.
    record toolbar-filter {
        /// The query parameter it sets: lowercase letters, digits and `_`,
        /// starting with a letter; not `q`, and unique on the page.
        param: string,
        /// What it filters by ("Rarity").
        label: string,
        /// 1 to 100: its values and their words ("32", "R32").
        choices: list<choice>,
        /// Several of its values at once, any of them (tags): the address
        /// lists them joined by commas, so values have none; else one.
        multiple: bool,
    }

    /// The toolbar above a page's lists. Tether draws one on every page
    /// with a table: a search box (`q` in the address) finding rows among
    /// those the page shows, and the page's tabs as view chips. A page that
    /// searches its own data (more than it shows, or by what it doesn't
    /// show) says so here and reads `q` from the request's query itself.
    record toolbar {
        /// The page searches its own data for `q`: the box's words
        /// ("Search moons, systems, refineries"). Left out, Tether finds
        /// rows among those shown.
        search: option<string>,
        /// At most 8.
        filters: list<toolbar-filter>,
    }

    /// A row's details beside the page's list, drawn while the page's
    /// address selects it: a row's name links to the same page with the
    /// row in the query (`moons?moon=40161234`), and `render` draws its
    /// panel. Close takes the parameter out again; the list keeps its
    /// search, filters and tab.
    record record-panel {
        /// The query parameter selecting the row (as a filter's).
        param: string,
        /// An overline: what it is ("Moon · R32").
        kind: string,
        title: string,
        /// A line under the title.
        context: option<string>,
        /// Its picture, drawn large: a ring of what it's made of.
        figure: option<composition>,
        /// Label and value pairs (at most 20).
        facts: list<tuple<string, value>>,
        /// Its own page, the panel's primary button ("Open moon").
        open: option<link>,
        /// One more button that posts ("Add to planner").
        action: option<action>,
    }

    record page {
        title: string,
        description: option<string>,
        sections: list<section>,
        /// Shown below the sections, one visible at a time.
        tabs: list<tab>,
        /// The plugin's related pages, beside the title (at most 8), as a
        /// segmented control with the one being shown marked; `primary`
        /// ones as buttons after it (e.g. "Create timer").
        links: list<link>,
        /// While set, the host reloads the page's content every this many
        /// seconds (5 to 300; others are brought into that range), e.g.
        /// while a first sync fills it in. It stops once a render leaves it
        /// out. Pages with a form, and audited pages, never reload.
        refresh-seconds: option<u32>,
        /// Its own search and filters (see `toolbar`).
        toolbar: option<toolbar>,
        /// The selected row's details, while one is selected (see
        /// `record-panel`).
        panel: option<record-panel>,
    }

    /// Which of the plugin's pages is wanted.
    record request {
        /// Relative to the plugin's pages; empty for its main page.
        path: string,
        query: list<tuple<string, string>>,
    }

    /// A posted form, its values checked against the form's fields: one
    /// value per field, in order. Checkboxes are `true` or `false`; empty
    /// optional fields are empty strings.
    record submission {
        /// The page the form is on, and its query.
        request: request,
        form: string,
        values: list<tuple<string, string>>,
    }

    /// What to show after a submission.
    variant submit-result {
        /// A page to show in place of the form's page (e.g. with a message,
        /// or the same form with a problem pointed out).
        page(page),
        /// Another of the plugin's pages to go to (a link path).
        redirect(string),
    }

    variant page-error {
        not-found,
        forbidden,
        /// Something went wrong; the text is for admins.
        failed(string),
    }
}

/// SQL in the plugin's own Postgres schema, for plugins approved for
/// storage (`storage = true`). Each call is one transaction: `query` and
/// `execute` run one statement, `transaction` runs several together or
/// none. Statements take `$1`, `$2`... parameters; never build SQL from
/// data. Only the plugin's own schema is visible.
interface storage {
    /// A parameter, or a value in a result row.
    variant value {
        null,
        boolean(bool),
        /// int2, int4 and int8 columns.
        integer(s64),
        /// float4 and float8.
        float(f64),
        /// text, varchar, char and name; also date, as `YYYY-MM-DD`.
        text(string),
        bytes(list<u8>),
        /// An instant in RFC 3339 (timestamptz, and timestamp read as UTC).
        timestamp(string),
        /// JSON text (json, jsonb).
        json(string),
    }

    record statement {
        sql: string,
        params: list<value>,
    }

    record rows {
        columns: list<string>,
        rows: list<list<value>>,
    }

    /// What Postgres said: the SQLSTATE code (e.g. `23505` for a unique
    /// violation) and its message.
    record database-error {
        code: string,
        message: string,
    }

    variant error {
        /// This plugin wasn't approved for storage.
        not-approved,
        /// A statement or its parameters break a limit or aren't valid; or a
        /// column has a type storage can't return (cast it, e.g. `::text`).
        invalid(string),
        database(database-error),
        /// It ran past the time a statement may take.
        timeout,
        /// The result has more rows or bytes than a call may return.
        too-large,
    }

    /// Runs a statement and returns its rows.
    query: func(sql: string, params: list<value>) -> result<rows, error>;
    /// Runs a statement and returns how many rows it changed.
    execute: func(sql: string, params: list<value>) -> result<u64, error>;
    /// Runs statements in one transaction; if one fails, none apply.
    transaction: func(statements: list<statement>) -> result<list<u64>, error>;
}

/// Who is looking. Only while drawing a page or handling a form; jobs
/// have no viewer.
interface identity {
    /// The access states every instance has.
    enum builtin {
        member,
        blue,
        guest,
    }

    /// An access state: Member, Blue, Guest, or one an admin made.
    record state {
        name: string,
        /// Set for Member, Blue and Guest, which can't be renamed.
        builtin: option<builtin>,
    }

    record character {
        id: s64,
        name: string,
        corporation-id: s64,
        alliance-id: option<s64>,
    }

    record viewer {
        /// Stable for the account; not a character id.
        account-id: s64,
        main: character,
        /// All of the account's characters, the main included.
        characters: list<character>,
        state: state,
        /// Which of this plugin's own permissions they hold (the names in
        /// `[permissions]`, without the `plugin.<id>.` prefix).
        permissions: list<string>,
    }

    /// The viewer, or none (in a job).
    current: func() -> option<viewer>;

    /// The character the viewer acts as: the one they chose in their
    /// account menu (Change character), else their main. Use it where you
    /// act for them (registering them, their fits, their requests); scope
    /// what they may see by `current`'s main and permissions, never by
    /// this. None in a job.
    acting: func() -> option<character>;

    /// Who owns one of `esi.characters`: their account's main and state.
    record owner {
        character-id: s64,
        main: character,
        state: state,
    }

    /// First-party Member Audit only: the owner of each of
    /// `esi.characters`, for aa-memberaudit's scopes, which go by the
    /// owner's main. Every other app gets none: apps never learn which
    /// characters share an account.
    owners: func() -> option<list<owner>>;

    /// A character on a member's account (see `members`).
    record member-character {
        character: character,
        /// Registered for the plugin (whether `esi.characters` lists it
        /// also depends on its token).
        registered: bool,
    }

    /// An account holding one of the plugin's permissions: its main, its
    /// state and every character on it.
    record member {
        main: character,
        state: state,
        /// Every character on the account, the main included, registered
        /// or not; none sold on.
        characters: list<member-character>,
    }

    /// First-party Member Audit only: every account holding one of its
    /// permissions, with all its characters, registered or not, for
    /// aa-memberaudit's Character Finder, compliance reports and sheet.
    /// Every other app gets none: apps never learn which characters share
    /// an account.
    members: func() -> option<list<member>>;

    /// A group, as Alliance Auth's: apps limit what they show to groups
    /// (allianceauth-fittings' categories do).
    record group {
        id: s64,
        name: string,
    }

    /// The viewer's own groups, or none (in a job). Only for a plugin
    /// approved for `groups` (`[capabilities] groups = true`); none for
    /// others.
    groups: func() -> list<group>;

    /// Groups the viewer may be offered to pick from (to limit something
    /// to them), as core shows groups: every group that is neither Hidden
    /// nor Internal, and the viewer's own; every group but Internal ones
    /// for holders of `group_management`; every group for holders of
    /// `admin.groups`. None in a job, and none for a plugin not approved
    /// for `groups`.
    all-groups: func() -> list<group>;

    /// Whether the viewer is a superuser (AA's `is_superuser`), for what
    /// AA shows superusers only; false in a job. (Superusers also hold
    /// every permission, so `permissions` lists all of yours for them.)
    superuser: func() -> bool;
}

/// ESI, through the host: plugins name an endpoint and whose token to use,
/// never a URL, and never see a token. Every call is checked against what
/// the admin approved (`capabilities.esi`) and the character's standing
/// (one of the plugin's characters: its account holds one of the plugin's
/// permissions and it registered for the plugin), and logged.
interface esi {
    use identity.{character};

    variant subject {
        /// One of the plugin's characters: see `characters`.
        character(s64),
        /// A data-source character (an app owner, added by a holder of the
        /// app's add permission): its corporation's
        /// data, for corporation endpoints.
        data-source(s64),
    }

    record response {
        /// The endpoint's JSON.
        body: string,
        /// For paged endpoints; 1 otherwise.
        pages: u32,
    }

    variant error {
        /// Not an endpoint Tether offers plugins, or its scope isn't one
        /// this plugin was approved for, or the wrong kind of subject.
        not-allowed(string),
        /// Not one of the plugin's characters: not registered for it, its
        /// account holds none of the plugin's permissions, or its token
        /// lacks a user scope.
        not-registered,
        /// Not a data source of this plugin (in use).
        not-a-data-source,
        /// The character's token is gone or revoked: they need to log in
        /// again.
        token,
        /// ESI answered with this HTTP status.
        status(u16),
        /// A parameter is wrong; why.
        invalid(string),
        /// The response is bigger than a call may return.
        too-large,
        /// ESI or Tether couldn't be reached.
        unavailable,
    }

    record named {
        id: s64,
        name: string,
        /// ESI's category: character, corporation, alliance,
        /// solar_system, station, inventory_type, ...
        category: string,
    }

    /// Calls a catalogue endpoint (see AGENTS.md) as `subject`. `params`
    /// are the endpoint's extra ids; `page` is for paged endpoints.
    get: func(endpoint: string, subject: subject, params: list<tuple<string, string>>, page: option<u32>) -> result<response, error>;
    /// Changes something in EVE: one of Tether's few write endpoints
    /// (see AGENTS.md; today `character-fitting-save`), with its JSON
    /// `body`, which the host checks. Only while a pilot submits one of
    /// the plugin's forms, and only for one of that pilot's own characters
    /// that is one of the plugin's characters: never in a page render or a
    /// job, never for anyone else. Sent once, never retried.
    post: func(endpoint: string, subject: subject, body: string) -> result<response, error>;
    /// The plugin's characters: registered for it, on accounts holding
    /// one of its permissions (any state, as Alliance Auth's apps), with
    /// tokens carrying every one of its user scopes. The bundled Member
    /// Audit also gets those whose token stopped working (not sold ones),
    /// as aa-memberaudit keeps them; reading one answers `token`.
    characters: func() -> list<character>;
    /// This plugin's data-source characters in use.
    data-sources: func() -> list<character>;
    /// Names for ids (public ESI; at most 1,000).
    names: func(ids: list<s64>) -> result<list<named>, error>;
}

/// Discord messages, for plugins approved for `send_message`, to channels
/// an admin assigned. Mentions are only Tether-managed state roles: never
/// @everyone, @here or people.
interface discord {
    record channel {
        /// Discord's id, as text.
        id: string,
        name: string,
    }

    variant mention {
        none,
        /// The Discord role mapped to the state with this name (any case),
        /// e.g. "Member".
        state(string),
    }

    variant error {
        /// Not an assigned channel, not approved, not now (pages can't
        /// send), or Discord refused the bot there; sending again won't
        /// help until an admin fixes it.
        not-allowed(string),
        /// The text breaks a limit; which.
        invalid(string),
        /// Sent too many lately; try later.
        rate-limited,
        unavailable,
    }

    /// A picture from CCP's image server, by what it shows: the host makes
    /// the link, so a card never points anywhere else.
    variant image {
        /// A character's portrait.
        character(s64),
        /// A corporation's logo.
        corporation(s64),
        /// An alliance's logo.
        alliance(s64),
        /// A ship's or structure's render, by type id.
        type-render(s64),
        /// An item's icon, by type id.
        type-icon(s64),
    }

    record embed-author {
        /// At most 256 characters.
        name: string,
        icon: option<image>,
    }

    record embed-field {
        /// At most 256 characters.
        name: string,
        /// At most 1,024 characters.
        value: string,
        /// Side by side with its neighbours (three to a row), or on its own
        /// line.
        inline: bool,
    }

    /// A card, as Discord draws embeds. Discord's markdown works in the
    /// description and field values; mentions in it never ping.
    record embed {
        /// At most 256 characters.
        title: string,
        /// At most 2,000 characters.
        description: option<string>,
        /// The bar down its side, `0xRRGGBB`.
        color: option<u32>,
        /// A line above the title, such as the owning corporation.
        author: option<embed-author>,
        /// Top right.
        thumbnail: option<image>,
        /// At most 10.
        fields: list<embed-field>,
        /// At most 256 characters.
        footer: option<string>,
        /// Shown beside the footer in each reader's own time (RFC 3339).
        timestamp: option<string>,
    }

    /// The channels an admin assigned this plugin.
    channels: func() -> list<channel>;
    /// Posts `text` (at most 1,500 characters) to an assigned channel.
    send: func(channel: string, text: string, mention: mention) -> result<_, error>;
    /// Posts a card to an assigned channel. The mention, if any, is the
    /// message's text above it.
    send-embed: func(channel: string, embed: embed, mention: mention) -> result<_, error>;
    /// As `send-embed`, its title a link to `page`: one of this plugin's
    /// own pages on this Tether, by its path as `[[pages]]` give it
    /// (e.g. "fleet/12", a query allowed). The host makes the address, so
    /// a card never links anywhere else.
    send-linked-embed: func(channel: string, embed: embed, page: string, mention: mention) -> result<_, error>;
}

/// Background work on Tether's job queue: the schedules declared in
/// `plugin.toml`, and one-off jobs a plugin queues itself. Either way the
/// host calls the plugin's `run-job` export.
interface jobs {
    /// A job to run, as `run-job` gets it.
    record job {
        /// The schedule's name, or the name it was queued under.
        name: string,
        key: option<string>,
        /// JSON text given when it was queued; `{}` for schedules.
        payload: string,
        /// When it was meant to run (RFC 3339). It may run later: after
        /// downtime, a restart, or retries.
        scheduled-at: string,
        /// 1 on the first run.
        attempt: u32,
    }

    variant job-error {
        /// Try again later, with backoff.
        retry(string),
        /// Never going to work: give up now.
        permanent(string),
    }

    record new-job {
        /// Lowercase letters, digits and `_`, at most 40.
        name: string,
        /// Queuing a job under a key replaces the queued job with the same
        /// key, so a job can be moved or updated without duplicates.
        key: option<string>,
        /// JSON text, at most 64 KiB.
        payload: string,
        /// When to run it (RFC 3339), at most 120 days ahead; none, or a
        /// past time, runs it as soon as possible.
        run-at: option<string>,
    }

    variant error {
        /// The job or key breaks a rule; why.
        invalid(string),
        /// The plugin already has as many queued jobs as it may.
        too-many,
        /// The queue couldn't be reached.
        unavailable,
    }

    /// Queues a job, or with a key, replaces the queued one with that key.
    enqueue: func(job: new-job) -> result<_, error>;
    /// Removes the queued job with this key; whether there was one.
    cancel: func(key: string) -> result<bool, error>;
}

/// Outbound HTTPS to the hosts an admin approved for this plugin
/// (`capabilities.http`), and nowhere else. The host sends the request:
/// it sets the User-Agent, adds a secret the plugin names (its value is
/// never shown to the plugin), follows redirects only within the approved
/// hosts, caps sizes, rate-limits each plugin and records every call.
interface http {
    enum method {
        get,
        post,
    }

    record request {
        method: method,
        /// A full `https://` URL on an approved host (port 443).
        url: string,
        /// Only `accept`, `accept-language`, `content-type`,
        /// `if-none-match` and `if-modified-since`; never credentials or
        /// cookies.
        headers: list<tuple<string, string>>,
        /// For POST; at most 64 KiB.
        body: option<list<u8>>,
        /// A secret declared in `capabilities.secrets` whose host is this
        /// URL's: the host adds it in its header.
        secret: option<string>,
    }

    record response {
        status: u16,
        /// Only a few safe ones: `content-type`, `etag`, `last-modified`,
        /// `cache-control`, `expires`, `age`, `retry-after`, lowercase.
        headers: list<tuple<string, string>>,
        /// At most 1 MiB.
        body: list<u8>,
    }

    variant error {
        /// Not an approved host, a header or method the host doesn't
        /// allow, a secret that isn't this plugin's (or isn't entered
        /// yet), or a redirect off the approved hosts; why.
        not-allowed(string),
        /// Too many requests: in this call, or by this plugin lately.
        too-many,
        /// The request body or the response is bigger than allowed.
        too-large,
        timeout,
        /// The host couldn't be reached, or answered something unreadable.
        unavailable,
    }

    /// Sends one request and returns the answer, whatever its status.
    send: func(request: request) -> result<response, error>;
}

/// Secure Groups filters the plugin offers, declared in `plugin.toml`
/// (`[[filters]]`), as aa-securegroups takes them from apps (skills,
/// assets, FATs). The host says which settings smart groups use; the plugin
/// works out a value per character from its own data and reports it, on its
/// own schedule. The host combines characters into accounts itself, so this
/// interface never tells a plugin which characters share an account.
interface filters {
    /// One filter setting smart groups use: the filter's name and the
    /// values an admin gave its fields, as a JSON object.
    record setting {
        name: string,
        config: string,
    }

    /// A character's value for one setting: 1 or 0 for yes-or-no filters,
    /// a count for filters that add up across characters.
    record value {
        character-id: s64,
        value: s64,
    }

    variant error {
        /// Not a declared filter, not a setting in use, or too many values.
        invalid(string),
        unavailable,
    }

    /// The settings of this plugin's filters that smart groups use now.
    wanted: func() -> list<setting>;
    /// Replaces this plugin's values for one setting (at most 100,000).
    /// Values more than two days old count as unknown, so report at least
    /// daily. Only from submit or a job.
    report: func(name: string, config: string, values: list<value>) -> result<_, error>;
}

/// Timers apps share, as aa-structures feeds Alliance Auth's timerboard:
/// one app publishes (with `timers = "publish"`), another shows them (with
/// `timers = "read"`). Nothing else passes between apps.
interface timers {
    record timer {
        /// The publisher's own id for it, e.g. a structure and state.
        key: string,
        /// What the timer is for, e.g. "Astrahus: armor timer".
        title: string,
        /// When it ends (RFC 3339, EVE time).
        at: string,
        /// Solar system name.
        system: string,
        details: string,
        /// `friendly`, `hostile` or `neutral`.
        objective: string,
        /// Only for pilots whose main is in this corporation.
        corporation-id: option<s64>,
    }

    record shared {
        timer: timer,
        /// The publishing app's name.
        source: string,
    }

    variant error {
        /// Not allowed (the capability, or a page), or a timer breaks a
        /// limit; which.
        invalid(string),
        unavailable,
    }

    /// Replaces this app's published timers (at most 500). Only from
    /// submit or a job.
    publish: func(timers: list<timer>) -> result<_, error>;
    /// Every app's published timers that haven't ended more than a day ago.
    published: func() -> result<list<shared>, error>;
}

/// Doctrines apps share, as allianceauth-fittings' doctrines appear in
/// aa-fleetpings and aa-fat: one app publishes (with `doctrines =
/// "publish"`), others offer them (with `doctrines = "read"`), and so may
/// Tether's Fleet Pings. Each is offered only to whoever may see it.
/// Nothing else passes between apps.
interface doctrines {
    record doctrine {
        /// The publisher's own id for it.
        key: string,
        name: string,
        /// Its page in the publishing app: a link path.
        link: string,
        /// Who sees it (AA's categories): none for everyone, else members
        /// of any of these groups (`identity.groups` ids).
        groups: option<list<s64>>,
    }

    record shared {
        name: string,
        /// Its page: the publishing app's address (`/plugins/<id>/<link>`).
        link: string,
        /// The publishing app's name.
        source: string,
    }

    variant error {
        /// Not allowed (the capability, or a page), or a doctrine breaks a
        /// limit; which.
        invalid(string),
        unavailable,
    }

    /// Replaces this app's published doctrines (at most 500), in the order
    /// given. Holders of `see-all`, one of this app's own permissions,
    /// see every one (AA's `fittings.manage`). Only from submit or a job.
    publish: func(doctrines: list<doctrine>, see-all: option<string>) -> result<_, error>;
    /// Published doctrines the viewer may see; none in a job.
    published: func() -> result<list<shared>, error>;
}

/// Files an app offers for download, as aa-memberaudit's data exports: the
/// app hands over rows (in a job, or a submit), the host writes the CSV
/// (quoting cells and defusing spreadsheet formulas), keeps it, and serves
/// it at the app's `downloads/<name>` to holders of the permission it
/// names, each download audited. Needs `downloads = true`.
interface downloads {
    variant error {
        /// Not allowed (the capability, a page), or a limit; which.
        invalid(string),
        /// Past the size a download may have.
        too-large,
        /// A newer build of it began (the daily run, or an update someone
        /// asked for): stop this one, the newer one carries on.
        superseded,
        unavailable,
    }

    record file {
        name: string,
        title: string,
        /// Rows, the header not counted.
        rows: u64,
        /// When it was finished (RFC 3339).
        built-at: string,
    }

    /// Starts building the download `name` (letters, digits, `-`; a new
    /// build replaces one left unfinished): its title, the app's own
    /// permission that may download it, and its column names. Returns the
    /// build, which `append` and `finish` name (carry it between jobs).
    begin: func(name: string, title: string, permission: string, header: list<string>) -> result<u32, error>;
    /// Adds rows to the build (at most 5,000 a call, each as many cells as
    /// the header).
    append: func(name: string, build: u32, rows: list<list<string>>) -> result<_, error>;
    /// Makes the build the file people download, replacing the last.
    finish: func(name: string, build: u32) -> result<_, error>;
    /// This app's finished downloads.
    files: func() -> list<file>;
}

/// Notices in Tether's notifications (the bell), as AA apps `notify`:
/// plain text to pilots who use this app. The host puts the app's name
/// before the title, skips one already waiting unread, and limits how
/// many an app sends. Only from submit or a job. Needs `notify = true`.
interface notify {
    enum level {
        info,
        success,
        warning,
        danger,
    }

    variant error {
        /// Not allowed (the capability, a page), or a limit; which.
        invalid(string),
        unavailable,
    }

    /// To one account (`identity`'s `account-id`), if it holds one of
    /// this app's own permissions; false if it doesn't (any more). Title
    /// at most 100 characters, message at most 1,000.
    account: func(account-id: s64, title: string, message: string, level: level) -> result<bool, error>;
    /// To every holder of `permission`, one of this app's own, but
    /// `except` (the one who acted, say); how many it reached.
    holders: func(permission: string, title: string, message: string, level: level, except: option<s64>) -> result<u32, error>;
}

world plugin {
    import log;
    import storage;
    import jobs;
    import identity;
    import esi;
    import discord;
    import http;
    import filters;
    import timers;
    import doctrines;
    import downloads;
    import notify;
    use jobs.{job, job-error};
    use page.{page, request, page-error, submission, submit-result};

    /// Renders one of the plugin's pages.
    export render: func(request: request) -> result<page, page-error>;
    /// Handles a posted form.
    export submit: func(submission: submission) -> result<submit-result, page-error>;
    /// Runs a scheduled or queued job.
    export run-job: func(job: job) -> result<_, job-error>;
}
