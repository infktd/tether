# Written by deploy/install.sh; these values are the only settings.
# Everything else is configured in the browser.
DOMAIN=auth.example.com
POSTGRES_PASSWORD=
SETUP_TOKEN=
# 64 hex characters. Encrypts SSO tokens and secrets at rest. Back it up:
# without it, stored tokens can't be decrypted (members just log in again).
ENCRYPTION_KEY=
# The reverse proxy (deploy/README.md): caddy (bundled, the default),
# nginx, traefik or none. `install.sh --proxy` sets it and the lines below.
TETHER_PROXY=caddy
# nginx and none: the app on 127.0.0.1:TETHER_PORT, Caddy off.
#TETHER_PORT=8080
#COMPOSE_FILE=docker-compose.yml:docker-compose.host-proxy.yml
# traefik: labels on the app, on Traefik's network, Caddy off.
#TRAEFIK_NETWORK=traefik
#TRAEFIK_CERTRESOLVER=letsencrypt
#TRAEFIK_ENTRYPOINT=websecure
#COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
