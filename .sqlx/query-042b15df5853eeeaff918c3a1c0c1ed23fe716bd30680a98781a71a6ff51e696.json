  "query": "\n        SELECT c.id, c.name, c.corporation_id, c.alliance_id\n        FROM core.characters c JOIN core.accounts a ON a.id = c.account_id\n        WHERE c.account_id = $1\n        ORDER BY c.id = a.main_character_id DESC, c.name\n        ",
