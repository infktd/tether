  "query": "\n        SELECT s.failing_since < now() - interval '20 hours' AS \"long_enough?\",\n               s.failure_notified, c.account_id\n        FROM core.corp_sources s JOIN core.characters c ON c.id = s.character_id\n        WHERE s.character_id = $1\n        FOR UPDATE OF s\n        ",
