  "query": "\n        SELECT a.is_owner, a.main_character_id, c.id, c.name\n        FROM core.accounts a\n        JOIN core.characters c ON c.account_id = a.id\n        WHERE a.id = $1\n        ORDER BY c.id = a.main_character_id DESC, c.name\n        ",
