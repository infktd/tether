{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT a.id AS account_id, c.id AS main_id, c.name AS main_name, a.tier\n        FROM core.group_members m\n        JOIN core.accounts a ON a.id = m.account_id\n        JOIN core.characters c ON c.id = a.main_character_id\n        WHERE m.group_id = $1\n        ORDER BY c.name\n        ",
