  "query": "\n        SELECT l.at, l.request_type, l.action, l.requestor_main,\n               n.name AS \"requestor_corporation?\", l.actor_name\n        FROM core.group_request_log l\n        LEFT JOIN core.entity_names n ON n.id = l.requestor_corporation_id\n        WHERE l.group_id = $1\n        ORDER BY l.id DESC\n        LIMIT $2\n        ",
