  "db_name": "PostgreSQL",
  "query": "\n        SELECT u.id, u.plugin_id, u.version, c.name AS \"uploaded_by?\", u.uploaded_at\n        FROM core.plugin_uploads u\n        LEFT JOIN core.accounts a ON a.id = u.uploaded_by\n        LEFT JOIN core.characters c ON c.id = a.main_character_id\n        ORDER BY u.id DESC\n        ",
