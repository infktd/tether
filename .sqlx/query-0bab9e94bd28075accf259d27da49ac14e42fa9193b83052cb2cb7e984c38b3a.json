  "query": "\n        SELECT c.id, c.name\n        FROM core.characters c JOIN core.accounts a ON a.id = c.account_id\n        WHERE c.account_id = $1\n        ORDER BY c.id = a.main_character_id DESC NULLS LAST, c.name\n        ",
