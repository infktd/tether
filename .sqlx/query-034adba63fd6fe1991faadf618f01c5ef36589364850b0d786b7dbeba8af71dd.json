  "query": "\n        SELECT r.id, r.item, r.state_id, r.group_id,\n               COALESCE(s.name, g.name) AS \"name!\"\n        FROM core.ping_restrictions r\n        LEFT JOIN core.states s ON s.id = r.state_id\n        LEFT JOIN core.groups g ON g.id = r.group_id\n        ORDER BY r.item, 5\n        ",
