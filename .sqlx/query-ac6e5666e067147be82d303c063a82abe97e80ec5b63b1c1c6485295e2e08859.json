  "db_name": "PostgreSQL",
  "query": "\n        SELECT g.id, g.name, g.description, g.internal, g.hidden, g.open, g.public,\n               g.restricted, g.compliance,\n               COALESCE((SELECT array_agg(s.state_id) FROM core.group_states s\n                         WHERE s.group_id = g.id), '{}') AS \"states!\"\n        FROM core.groups g\n        ORDER BY g.name\n        ",
