  "query": "\n        SELECT g.id, g.name, g.description, g.join_policy,\n               (SELECT count(*) FROM core.group_members m WHERE m.group_id = g.id) AS \"members!\",\n               (SELECT count(*) FROM core.group_requests r WHERE r.group_id = g.id) AS \"pending!\"\n        FROM core.groups g\n        ORDER BY g.name\n        ",
