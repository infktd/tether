{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT l.account_id, COALESCE(c.id, 0) AS \"main_id!\",\n               COALESCE(c.name, '(no main)') AS \"name!\"\n        FROM core.group_leaders l\n        JOIN core.accounts a ON a.id = l.account_id\n        LEFT JOIN core.characters c ON c.id = a.main_character_id\n        WHERE l.group_id = $1\n        ORDER BY 3\n        ",
