{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT s.account_id, s.expires_at,\n               s.last_seen_at < now() - make_interval(secs => $2) AS \"stale!\"\n        FROM core.sessions s JOIN core.accounts a ON a.id = s.account_id\n        WHERE s.token_hash = $1 AND s.expires_at > now() AND a.active\n        ",
