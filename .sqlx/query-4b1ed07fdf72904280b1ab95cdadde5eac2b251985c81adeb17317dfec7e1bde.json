  "query": "\n                SELECT r.account_id AS \"account_id!\", a.main_character_id, a.active\n                FROM core.ownership_records r JOIN core.accounts a ON a.id = r.account_id\n                WHERE r.character_id = $1 AND r.owner_hash = $2\n                ORDER BY r.id DESC\n                LIMIT 1\n                ",
