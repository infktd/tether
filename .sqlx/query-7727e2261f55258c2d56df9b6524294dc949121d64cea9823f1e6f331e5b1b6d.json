  "query": "\n        SELECT r.account_id, c.name AS main_name\n        FROM core.group_requests r\n        JOIN core.accounts a ON a.id = r.account_id\n        JOIN core.characters c ON c.id = a.main_character_id\n        WHERE r.group_id = $1\n        ORDER BY r.requested_at\n        ",
