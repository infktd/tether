  "query": "\n        SELECT a.id, m.id AS main_id, m.name AS main_name,\n               a.state_id, a.state_evaluated_at\n        FROM core.accounts a\n        JOIN core.characters m ON m.id = a.main_character_id\n        WHERE NOT a.compliant\n        ORDER BY m.name\n        ",
