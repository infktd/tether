  "query": "\n        WITH marked AS (\n            UPDATE core.notifications SET read_at = now()\n            WHERE id = $1 AND account_id = $2 AND read_at IS NULL\n        )\n        SELECT id, level, title, message, created_at, true AS \"read!\"\n        FROM core.notifications WHERE id = $1 AND account_id = $2\n        ",
