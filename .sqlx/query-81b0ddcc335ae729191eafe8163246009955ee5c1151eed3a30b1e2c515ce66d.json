  "query": "\n        DELETE FROM core.permission_grants\n        WHERE permission IN (\n            SELECT permission FROM core.plugin_permissions\n            WHERE plugin_id = $1 AND NOT permission = ANY($2)\n        )\n        RETURNING id, permission, state_id, group_id\n        ",
