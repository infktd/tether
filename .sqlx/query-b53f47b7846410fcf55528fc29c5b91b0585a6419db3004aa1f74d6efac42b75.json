  "query": "\n        SELECT s.id AS state_id, s.builtin, count(a.id) AS \"accounts!\"\n        FROM core.states s\n        LEFT JOIN core.accounts a ON a.state_id = s.id AND a.active\n        GROUP BY s.id, s.builtin\n        ORDER BY s.id\n        ",
