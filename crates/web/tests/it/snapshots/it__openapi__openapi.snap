  "components": {
    "schemas": {
      "AuditEntryOut": {
        "type": "object",
        "required": [
          "id",
          "at",
          "action",
          "details"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "actor_account_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "actor_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "details": {
            "type": "object"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CharacterRef": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CharacterSummary": {
        "type": "object",
        "required": [
          "id",
          "name",
          "is_main"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "is_main": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CheckOut": {
        "type": "object",
        "required": [
          "ok",
          "url",
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "CoverIn": {
        "type": "object",
        "required": [
          "entity_id"
        ],
        "properties": {
          "entity_id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "CoveredOut": {
        "type": "object",
        "required": [
          "entity_id",
          "kind",
          "name"
        ],
        "properties": {
          "entity_id": {
            "type": "integer",
            "format": "int64"
          },
          "kind": {
            "type": "string",
            "description": "`alliance`, `corporation`, `character` or `faction`."
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Created": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "EntityOut": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "GrantIn": {
        "type": "object",
        "required": [
          "permission"
        ],
        "properties": {
          "group_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "permission": {
            "type": "string"
          },
          "state_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        }
      },
      "GrantOut": {
        "type": "object",
        "required": [
          "id",
          "permission"
        ],
        "properties": {
          "group_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "permission": {
            "type": "string"
          },
          "state_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        }
      },
      "GroupOut": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "kind",
          "is_member"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "is_member": {
            "type": "boolean"
          },
          "kind": {
            "type": "string",
            "description": "`open` (in or out at once), `requestable` (leaders approve) or\n`internal` (admins only; listed only when you're in it)."
          },
          "name": {
            "type": "string"
          },
          "pending": {
            "type": [
              "string",
              "null"
            ],
            "description": "A pending request: `join` or `leave`."
          }
        }
      },
      "GroupSettings": {
        "type": "object",
        "required": [
          "internal",
          "hidden",
          "open",
          "public",
          "restricted"
        ],
        "properties": {
          "compliance": {
            "type": "boolean",
            "description": "A compliance group (Internal only): Tether keeps its members."
          },
          "description": {
            "type": "string"
          },
          "hidden": {
            "type": "boolean"
          },
          "internal": {
            "type": "boolean"
          },
          "open": {
            "type": "boolean"
          },
          "public": {
            "type": "boolean"
          },
          "restricted": {
            "type": "boolean"
          },
          "states": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Only these states may be in it; empty for every state."
          }
        }
      },
      "LogOut": {
        "type": "object",
        "required": [
          "at",
          "request_type",
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "description": "`accept` or `reject`."
          },
          "actor_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "request_type": {
            "type": "string",
            "description": "`join`, `leave` or `removed`."
          },
          "requestor_corporation": {
            "type": [
              "string",
              "null"
            ]
          },
          "requestor_main": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Me": {
        "type": "object",
        "required": [
          "account_id",
          "is_owner",
          "state",
          "characters",
          "groups",
          "permissions"
        ],
        "properties": {
          "account_id": {
            "type": "integer",
            "format": "int64"
          },
          "characters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CharacterSummary"
            }
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "is_owner": {
            "type": "boolean"
          },
          "main": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CharacterRef",
                "description": "`None` after the main was sold or lost its token, until Change Main."
              },
              {
                "type": "null"
              }
            ]
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "state": {
            "type": "string",
            "description": "The access state's name: Member, Blue, Guest or one an admin made."
          }
        }
      },
      "MemberIn": {
        "type": "object",
        "required": [
          "account_id"
        ],
        "properties": {
          "account_id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "MemberOut": {
        "type": "object",
        "required": [
          "account_id",
          "main_name",
          "state"
        ],
        "properties": {
          "account_id": {
            "type": "integer",
            "format": "int64"
          },
          "main_name": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        }
      },
      "MoveIn": {
        "type": "object",
        "required": [
          "direction"
        ],
        "properties": {
          "direction": {
            "type": "string",
            "description": "`up` (higher priority) or `down`."
          },
          "past": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "The state expected to be passed; refused with 409 if the order\nchanged."
          }
        }
      },
      "NewGroup": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "hidden": {
            "type": "boolean",
            "description": "Not listed; joinable through its direct link (default)."
          },
          "internal": {
            "type": "boolean",
            "description": "Only admins change its members (default, as AA's)."
          },
          "name": {
            "type": "string"
          },
          "open": {
            "type": "boolean",
            "description": "Join and leave without approval."
          },
          "public": {
            "type": "boolean",
            "description": "Joinable without `request_groups`."
          },
          "restricted": {
            "type": "boolean",
            "description": "Only the owner changes its members or this flag."
          }
        }
      },
      "NotificationOut": {
        "type": "object",
        "required": [
          "id",
          "level",
          "title",
          "message",
          "created_at",
          "read"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "level": {
            "type": "string",
            "description": "`danger`, `warning`, `info` or `success`."
          },
          "message": {
            "type": "string"
          },
          "read": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "PermissionInfo": {
        "type": "object",
        "required": [
          "name",
          "description"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "PermissionsOut": {
        "type": "object",
        "required": [
          "available",
          "grants"
        ],
        "properties": {
          "available": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PermissionInfo"
            }
          },
          "grants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GrantOut"
            }
          }
        }
      },
      "RefreshOut": {
        "type": "object",
        "required": [
          "result"
        ],
        "properties": {
          "result": {
            "type": "string",
            "description": "`valid`, `revoked` (log in with it again) or `sold` (it left the\naccount)."
          }
        }
      },
      "RequestOut": {
        "type": "object",
        "required": [
          "group_id",
          "group_name",
          "account_id",
          "main_name",
          "leave",
          "requested_at"
        ],
        "properties": {
          "account_id": {
            "type": "integer",
            "format": "int64"
          },
          "group_id": {
            "type": "integer",
            "format": "int64"
          },
          "group_name": {
            "type": "string"
          },
          "leave": {
            "type": "boolean",
            "description": "True for a request to leave."
          },
          "main_name": {
            "type": "string"
          },
          "requested_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ReservedName": {
        "type": "object",
        "required": [
          "name",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "ResolveIn": {
        "type": "object",
        "required": [
          "names"
        ],
        "properties": {
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ResolveOut": {
        "type": "object",
        "required": [
          "alliances",
          "corporations",
          "characters",
          "factions"
        ],
        "properties": {
          "alliances": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntityOut"
            }
          },
          "characters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntityOut"
            }
          },
          "corporations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntityOut"
            }
          },
          "factions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntityOut"
            },
            "description": "Faction warfare militias."
          }
        }
      },
      "ScopeIn": {
        "type": "object",
        "required": [
          "scope"
        ],
        "properties": {
          "scope": {
            "type": "string"
          }
        }
      },
      "SetMain": {
        "type": "object",
        "required": [
          "character_id"
        ],
        "properties": {
          "character_id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "SetupState": {
        "type": "string",
        "enum": [
          "needs_sso",
          "needs_owner",
          "needs_alliance",
          "complete"
        ]
      },
      "SetupStatus": {
        "type": "object",
        "required": [
          "state",
          "callback_url",
          "sso_configured",
          "owner_exists",
          "unlocked"
        ],
        "properties": {
          "callback_url": {
            "type": "string",
            "description": "Register exactly this with CCP."
          },
          "owner_exists": {
            "type": "boolean"
          },
          "sso_configured": {
            "type": "boolean"
          },
          "state": {
            "$ref": "#/components/schemas/SetupState"
          },
          "suggested": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Suggestion",
                "description": "For admins at the alliance step: the owner main's own alliance (or\ncorporation if it has no alliance)."
              },
              {
                "type": "null"
              }
            ]
          },
          "unlocked": {
            "type": "boolean",
            "description": "This browser holds a valid setup session."
          }
        }
      },
      "SsoIn": {
        "type": "object",
        "required": [
          "client_id"
        ],
        "properties": {
          "client_id": {
            "type": "string"
          }
        }
      },
      "SsoOut": {
        "type": "object",
        "required": [
          "callback_url"
        ],
        "properties": {
          "callback_url": {
            "type": "string"
          }
        }
      },
      "StateNameIn": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "StateOut": {
        "type": "object",
        "required": [
          "id",
          "name",
          "priority",
          "accounts",
          "covers",
          "required_scopes",
          "added_scopes"
        ],
        "properties": {
          "accounts": {
            "type": "integer",
            "format": "int64",
            "description": "Accounts in the state now."
          },
          "added_scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The scopes an admin added (a subset of `required_scopes`)."
          },
          "builtin": {
            "type": [
              "string",
              "null"
            ],
            "description": "`member`, `blue` or `guest` for the built-in states."
          },
          "covers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CoveredOut"
            }
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "format": "int32",
            "description": "Higher wins; Guest is 0."
          },
          "required_scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Scopes every character must grant: for Member, the installed\nplugins' user scopes too."
          }
        }
      },
      "StatePatch": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Higher wins; 1 or more, and no other state's (Guest is 0)."
          }
        }
      },
      "StatusOut": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "`member` or `left` (done at once), or `requested` (awaiting the\ngroup's leaders)."
          }
        }
      },
      "Suggestion": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "TokenOut": {
        "type": "object",
        "required": [
          "character_id",
          "character_name",
          "is_main",
          "scopes",
          "state",
          "created_at"
        ],
        "properties": {
          "character_id": {
            "type": "integer",
            "format": "int64"
          },
          "character_name": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "is_main": {
            "type": "boolean"
          },
          "last_refreshed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "state": {
            "type": "string",
            "description": "`valid`, `revoked` or `deleted`."
          }
        }
      },
      "UnlockIn": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "UnreadOut": {
        "type": "object",
        "required": [
          "unread"
        ],
        "properties": {
          "unread": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    },
    "securitySchemes": {
      "access_token": {
        "type": "http",
        "scheme": "bearer",
        "description": "A personal access token (tether_pat_...) made on the Dashboard: only /api/admin/ endpoints whose permission it carries, and GET /api/me with account:read"
      },
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-tether_session",
        "description": "Session cookie from logging in with EVE SSO at /auth/login"
      }
    }
  },
  "tags": [
    {
      "name": "health",
      "description": "Liveness and readiness"
    },
    {
      "name": "account",
      "description": "The signed-in account"
    },
    {
      "name": "notifications",
      "description": "Your notifications"
    },
    {
      "name": "groups",
      "description": "Joining and leaving groups"
    },
    {
      "name": "group management",
      "description": "Requests, members and the Audit Log of the groups you manage"
    },
    {
      "name": "admin",
      "description": "Groups, permissions, states and the audit log"
    },
    {
      "name": "setup",
      "description": "First-run wizard"
    }
  ]
}
