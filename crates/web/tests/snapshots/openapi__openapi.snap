          },
          "permission": {
            "type": "string"
          },
          "tier": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "GrantOut": {
        "type": "object",
        "required": [
          "id",
          "permission"
        ],
        "properties": {
          "group_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "permission": {
            "type": "string"
          },
          "tier": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "GroupOut": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "join_policy",
          "is_member",
