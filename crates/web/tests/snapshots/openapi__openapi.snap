                }
              }
            }
          },
          "401": {},
          "403": {}
        }
      }
    },
    "/api/setup/probe": {
      "get": {
        "tags": [
          "setup"
        ],
        "summary": "`GET /api/setup/probe?nonce=`: echoes the nonce so the callback check\ncan tell this instance answered.",
        "operationId": "probe",
        "parameters": [
          {
            "name": "nonce",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {}
        }
      }
    },
    "/api/setup/sso": {
      "post": {
        "tags": [
          "setup"
        ],
        "summary": "`POST /api/setup/sso`: set the EVE SSO client id.",
        "operationId": "set_sso",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SsoIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SsoOut"
                }
              }
            }
          },
          "400": {},
          "401": {},
          "403": {}
        }
      }
    },
    "/api/setup/unlock": {
      "post": {
        "tags": [
          "setup"
        ],
        "summary": "`POST /api/setup/unlock`: exchange the setup token for a setup session.",
        "operationId": "unlock",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UnlockIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Unlocked; sets the setup cookie"
          },
          "403": {
            "description": "Wrong token"
          },
          "410": {
            "description": "Setup is finished"
          },
          "429": {
            "description": "Too many attempts from this IP"
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness: the process is up and serving HTTP.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "ok"
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness: the database answers.",
        "operationId": "ready",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "ready"
              }
            }
          },
          "503": {
            "description": "Database unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuditEntryOut": {
        "type": "object",
        "required": [
          "id",
          "at",
          "action",
          "details"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "actor_account_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "actor_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "details": {
            "type": "object"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CharacterRef": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CharacterSummary": {
        "type": "object",
        "required": [
          "id",
          "name",
          "is_main"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "is_main": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CheckOut": {
        "type": "object",
        "required": [
          "ok",
          "url",
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "CoverIn": {
        "type": "object",
        "required": [
          "entity_id"
        ],
        "properties": {
          "entity_id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "CoveredOut": {
        "type": "object",
        "required": [
          "entity_id",
          "kind",
          "name"
        ],
        "properties": {
          "entity_id": {
            "type": "integer",
            "format": "int64"
          },
          "kind": {
            "type": "string",
            "description": "`alliance`, `corporation` or `character`."
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Created": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "EntityOut": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "GrantIn": {
        "type": "object",
        "required": [
          "permission"
        ],
        "properties": {
          "group_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "permission": {
            "type": "string"
          },
          "state_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        }
      },
      "GrantOut": {
        "type": "object",
        "required": [
          "id",
          "permission"
        ],
        "properties": {
          "group_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "permission": {
            "type": "string"
          },
          "state_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        }
      },
      "GroupOut": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "join_policy",
          "is_member",
          "has_requested"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "has_requested": {
            "type": "boolean"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "is_member": {
            "type": "boolean"
          },
          "join_policy": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "JoinOut": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "`member` (joined an open group) or `requested` (awaiting approval)."
          }
        }
      },
      "Me": {
        "type": "object",
        "required": [
          "account_id",
          "is_owner",
          "state",
          "characters",
          "groups",
          "permissions"
        ],
        "properties": {
          "account_id": {
            "type": "integer",
            "format": "int64"
          },
          "characters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CharacterSummary"
            }
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "is_owner": {
            "type": "boolean"
          },
          "main": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CharacterRef",
                "description": "`None` after the main was sold or lost its token, until Change Main."
              },
              {
                "type": "null"
              }
            ]
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "state": {
            "type": "string",
            "description": "The access state's name: Member, Blue, Guest or one an admin made."
          }
        }
      },
      "MemberIn": {
        "type": "object",
        "required": [
          "account_id"
        ],
        "properties": {
          "account_id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "MoveIn": {
        "type": "object",
        "required": [
          "direction"
        ],
        "properties": {
          "direction": {
            "type": "string",
            "description": "`up` (higher priority) or `down`."
          },
          "past": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "The state expected to be passed; refused with 409 if the order\nchanged."
          }
        }
      },
      "NewGroup": {
        "type": "object",
        "required": [
          "name",
          "join_policy"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "join_policy": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "PermissionInfo": {
        "type": "object",
        "required": [
          "name",
          "description"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "PermissionsOut": {
        "type": "object",
        "required": [
          "available",
          "grants"
        ],
        "properties": {
          "available": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PermissionInfo"
            }
          },
          "grants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GrantOut"
            }
          }
        }
      },
      "RequestOut": {
        "type": "object",
        "required": [
          "account_id",
          "main_name"
        ],
        "properties": {
          "account_id": {
            "type": "integer",
            "format": "int64"
          },
          "main_name": {
            "type": "string"
          }
        }
      },
      "ResolveIn": {
        "type": "object",
        "required": [
          "names"
        ],
        "properties": {
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ResolveOut": {
        "type": "object",
        "required": [
          "alliances",
          "corporations",
          "characters"
        ],
        "properties": {
          "alliances": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntityOut"
            }
          },
          "characters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntityOut"
            }
          },
          "corporations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntityOut"
            }
          }
        }
      },
      "ScopeIn": {
        "type": "object",
        "required": [
          "scope"
        ],
        "properties": {
          "scope": {
            "type": "string"
          }
        }
      },
      "SetMain": {
        "type": "object",
        "required": [
          "character_id"
        ],
        "properties": {
          "character_id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "SetupState": {
        "type": "string",
        "enum": [
          "needs_sso",
          "needs_owner",
          "needs_alliance",
          "complete"
        ]
      },
      "SetupStatus": {
        "type": "object",
        "required": [
          "state",
          "callback_url",
          "sso_configured",
          "owner_exists",
          "unlocked"
        ],
        "properties": {
          "callback_url": {
            "type": "string",
            "description": "Register exactly this with CCP."
          },
          "owner_exists": {
            "type": "boolean"
          },
          "sso_configured": {
            "type": "boolean"
          },
          "state": {
            "$ref": "#/components/schemas/SetupState"
          },
          "suggested": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Suggestion",
                "description": "For admins at the alliance step: the owner main's own alliance (or\ncorporation if it has no alliance)."
              },
              {
                "type": "null"
              }
            ]
          },
          "unlocked": {
            "type": "boolean",
            "description": "This browser holds a valid setup session."
          }
        }
      },
      "SsoIn": {
        "type": "object",
        "required": [
          "client_id"
        ],
        "properties": {
          "client_id": {
            "type": "string"
          }
        }
      },
      "SsoOut": {
        "type": "object",
        "required": [
          "callback_url"
        ],
        "properties": {
          "callback_url": {
            "type": "string"
          }
        }
      },
      "StateNameIn": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "StateOut": {
        "type": "object",
        "required": [
          "id",
          "name",
          "priority",
          "accounts",
          "covers",
          "required_scopes",
          "added_scopes"
        ],
        "properties": {
          "accounts": {
            "type": "integer",
            "format": "int64",
            "description": "Accounts in the state now."
          },
          "added_scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The scopes an admin added (a subset of `required_scopes`)."
          },
          "builtin": {
            "type": [
              "string",
              "null"
            ],
            "description": "`member`, `blue` or `guest` for the built-in states."
          },
          "covers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CoveredOut"
            }
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "format": "int32",
            "description": "Higher wins; Guest is 0."
          },
          "required_scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Scopes every character must grant: for Member, the installed\nplugins' user scopes too."
          }
        }
      },
      "StatePatch": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Higher wins; 1 or more, and no other state's (Guest is 0)."
          }
        }
      },
      "Suggestion": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "UnlockIn": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-tether_session",
        "description": "Session cookie from logging in with EVE SSO at /auth/login"
      }
    }
  },
  "tags": [
    {
      "name": "health",
      "description": "Liveness and readiness"
    },
    {
      "name": "account",
      "description": "The signed-in account"
    },
    {
      "name": "groups",
      "description": "Joining and leaving groups"
    },
    {
      "name": "admin",
      "description": "Groups, permissions, states and the audit log"
    },
    {
      "name": "setup",
      "description": "First-run wizard"
    }
  ]
}
