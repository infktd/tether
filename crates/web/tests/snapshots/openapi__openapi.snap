        "properties": {
          "status": {
            "type": "string",
            "description": "`member` (joined an open group) or `requested` (awaiting approval)."
          }
        }
      },
      "Me": {
        "type": "object",
        "required": [
          "account_id",
          "is_owner",
          "tier",
          "main",
          "characters",
          "groups",
          "permissions"
        ],
        "properties": {
          "account_id": {
            "type": "integer",
            "format": "int64"
          },
          "characters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CharacterSummary"
            }
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "is_owner": {
            "type": "boolean"
          },
          "main": {
            "$ref": "#/components/schemas/CharacterRef"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tier": {
            "type": "string"
          }
        }
      },
      "MemberIn": {
        "type": "object",
        "required": [
          "account_id"
        ],
        "properties": {
          "account_id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "NewGroup": {
        "type": "object",
        "required": [
          "name",
          "join_policy"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "join_policy": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "PermissionInfo": {
        "type": "object",
        "required": [
          "name",
          "description"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "PermissionsOut": {
        "type": "object",
        "required": [
          "available",
          "grants"
        ],
        "properties": {
          "available": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PermissionInfo"
            }
          },
          "grants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GrantOut"
            }
          }
        }
      },
      "RequestOut": {
        "type": "object",
        "required": [
          "account_id",
          "main_name"
        ],
        "properties": {
          "account_id": {
            "type": "integer",
            "format": "int64"
          },
          "main_name": {
            "type": "string"
          }
        }
      },
      "ResolveIn": {
        "type": "object",
        "required": [
          "names"
        ],
        "properties": {
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ResolveOut": {
        "type": "object",
        "required": [
          "alliances",
          "corporations"
        ],
        "properties": {
          "alliances": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntityOut"
            }
          },
          "corporations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntityOut"
            }
          }
        }
      },
      "SetMain": {
        "type": "object",
        "required": [
          "character_id"
        ],
        "properties": {
          "character_id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "SetupState": {
        "type": "string",
        "enum": [
          "needs_sso",
          "needs_owner",
          "needs_alliance",
          "complete"
        ]
      },
      "SetupStatus": {
        "type": "object",
        "required": [
          "state",
          "callback_url",
          "sso_configured",
          "owner_exists",
          "unlocked"
        ],
        "properties": {
          "callback_url": {
            "type": "string",
            "description": "Register exactly this with CCP."
          },
          "owner_exists": {
            "type": "boolean"
          },
          "sso_configured": {
            "type": "boolean"
          },
          "state": {
            "$ref": "#/components/schemas/SetupState"
          },
          "suggested": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Suggestion",
                "description": "For admins at the alliance step: the owner main's own alliance (or\ncorporation if it has no alliance)."
              },
              {
                "type": "null"
              }
            ]
          },
          "unlocked": {
            "type": "boolean",
            "description": "This browser holds a valid setup session."
          }
        }
      },
      "SsoIn": {
        "type": "object",
        "required": [
          "client_id"
        ],
        "properties": {
          "client_id": {
            "type": "string"
          }
        }
      },
      "SsoOut": {
        "type": "object",
        "required": [
          "callback_url"
        ],
        "properties": {
          "callback_url": {
            "type": "string"
          }
        }
      },
      "Suggestion": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "TierRuleIn": {
        "type": "object",
        "required": [
          "entity_id",
          "tier"
        ],
        "properties": {
          "entity_id": {
            "type": "integer",
            "format": "int64"
          },
          "tier": {
            "type": "string"
          }
        }
      },
      "TierRuleOut": {
        "type": "object",
        "required": [
          "entity_id",
          "kind",
          "tier",
          "name"
        ],
        "properties": {
          "entity_id": {
            "type": "integer",
            "format": "int64"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "tier": {
            "type": "string"
          }
        }
      },
      "UnlockIn": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-tether_session",
        "description": "Session cookie from logging in with EVE SSO at /auth/login"
      }
    }
  },
  "tags": [
    {
      "name": "health",
      "description": "Liveness and readiness"
    },
    {
      "name": "account",
      "description": "The signed-in account"
    },
    {
      "name": "groups",
      "description": "Joining and leaving groups"
    },
    {
      "name": "admin",
      "description": "Groups, permissions, tier rules and the audit log"
    },
    {
      "name": "setup",
      "description": "First-run wizard"
    }
  ]
}
