    "/api/setup/callback-check": {
      "post": {
        "tags": [
          "setup"
        ],
        "summary": "`POST /api/setup/callback-check`: fetch our own public URL the way CCP's\nredirect will reach it (DNS, TLS, reverse proxy) and confirm this\ninstance answers. Matching the URL registered at CCP is proven by the\nfirst login.",
        "operationId": "callback_check",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckOut"
                }
              }
            }
          },
          "401": {},
          "403": {}
        }
      }
    },
