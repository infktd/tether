    },
    "/api/setup/unlock": {
      "post": {
        "tags": [
          "setup"
        ],
        "summary": "`POST /api/setup/unlock`: exchange the setup token for a setup session.",
        "operationId": "unlock",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UnlockIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Unlocked; sets the setup cookie"
          },
          "403": {
            "description": "Wrong token"
          },
          "410": {
            "description": "Setup is finished"
          },
          "429": {
            "description": "Too many attempts from this IP"
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness: the process is up and serving HTTP.",
